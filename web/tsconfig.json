{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@agentcap/core": ["../packages/core/src/index.ts"],
      "@agentcap/policy": ["../worker/src/policy.ts"],
      "@agentcap/recover": ["../worker/src/recover.ts"],
      "@agentcap/grant-store": ["../worker/src/grant-store.ts"],
      "@agentcap/command-files": ["../worker/src/command-files.ts"],
      "@agentcap/settings-store": ["../worker/src/settings-store.ts"],
      "@agentcap/thesis": ["../worker/src/thesis-policy.ts"],
      "@agentcap/feed-history": ["../worker/src/read-feed-history.ts"],
      "@agentcap/identity-store": ["../worker/src/identity-store.ts"],
      "@agentcap/follow-store": ["../worker/src/follow-store.ts"],
      "@agentcap/image-store": ["../worker/src/image-store.ts"],
      "@agentcap/store": ["../worker/src/store.ts"],
      "@agentcap/llm": ["../worker/src/llm.ts"],
      "@agentcap/settings": ["../worker/src/settings.ts"],
      "@agentcap/home": ["../worker/src/home.ts"],
      "@agentcap/atomic-write": ["../worker/src/atomic-write.ts"],
      "@agentcap/db": ["../worker/src/db.ts"],
      "@agentcap/backtest": ["../worker/src/backtest.ts"],
      "@agentcap/backtest-scenario": ["../worker/src/backtest-scenario.ts"],
      "@agentcap/limits": ["../worker/src/limits.ts"],
      "@agentcap/playground-api": ["../worker/src/playground-api.ts"],
      "@agentcap/wall-battery": ["../worker/src/wall-battery.ts"],
      "@agentcap/strategies/*": ["../worker/src/strategies/*"],
      "@agentcap/pnl-card": ["../worker/src/pnl-card.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
